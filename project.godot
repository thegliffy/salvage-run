; Salvage Run - project configuration
; Engine: Godot 4.7.2

config_version=5

[application]

config/name="Salvage Run"
config/description="Steal a ship, fight across three sectors, sell it for salvage — unlock new parts and bigger hulls to steal next."
config/version="0.25"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
Rng="*res://src/core/rng.gd"
Database="*res://src/core/database.gd"
SaveSystem="*res://src/core/save_system.gd"
Game="*res://src/core/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/min_width=960
window/size/min_height=540
; canvas_items + expand: scale the 1280x720 design uniformly, then grow the
; viewport in the leftover dimension so 16:10 / ultrawide is not letterboxed.
; Screens must layout to the live viewport (see MapScreen.layout_metrics) —
; expand does not shrink overflowing fixed-pixel content.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[input_devices]

pointing/emulate_mouse_from_touch=true
